# Server Environment Configuration
# Node environment mode: development | test | production
NODE_ENV=development

# HTTP listening port
PORT=5000

# MongoDB connection string (supports local standalone or replica set for transactions)
# NOTE: MongoDB Atlas free tier does NOT support multi-document transactions.
# Unique indexes are used instead for financial consistency guarantees.
MONGODB_URI=mongodb://127.0.0.1:27017/devconnect

# JWT authentication secret (minimum 16 characters in production)
JWT_SECRET=replace_with_a_secure_random_secret_key_minimum_16_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Allowed client origin for CORS and cookies
CLIENT_URL=http://localhost:3000

# Optional Cloudinary Storage Configuration for uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Phase 7: Stripe Payment Provider ──────────────────────────────────────────
# Setup instructions:
#   1. Create a Stripe account at https://stripe.com
#   2. Use TEST mode keys (sk_test_...) for development and testing
#   3. NEVER commit real secret keys to source control
#   4. Register your webhook endpoint in the Stripe Dashboard:
#      URL: https://your-domain.com/api/v1/webhooks/payments/stripe
#      Events: checkout.session.completed, checkout.session.expired,
#              payment_intent.payment_failed, charge.refunded
#   5. Copy the webhook signing secret (whsec_...) to STRIPE_WEBHOOK_SECRET
#
# IMPORTANT: Payment features will gracefully fail with a clear error if these
# are not set. Other app features continue to work without Stripe credentials.
#
# For local webhook testing, install Stripe CLI and run:
#   stripe listen --forward-to localhost:5000/api/v1/webhooks/payments/stripe
#
STRIPE_SECRET_KEY=sk_test_replace_with_your_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_signing_secret

# ── Payment Business Model Notes ──────────────────────────────────────────────
# This platform facilitates direct payments from clients to the platform Stripe account.
# Funds are NOT held in escrow. Developer payouts are handled operationally.
# Stripe Connect (for automated developer payouts) is planned for a future phase.
