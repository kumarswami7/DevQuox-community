# ==============================================================================
# DevConnect — Root Environment Configuration Template
# Copy this file to server/.env or configure your production environment
# ==============================================================================

# Node Environment Mode: development | test | production
NODE_ENV=development

# Backend HTTP Server Port
PORT=5000

# MongoDB Connection URI (supports local standalone or MongoDB Atlas cluster)
# For local MongoDB: mongodb://127.0.0.1:27017/devconnect
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/devconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/devconnect

# JWT Secret Key (minimum 16 characters in production)
JWT_SECRET=devconnect_super_secret_development_key_minimum_32_characters

# Allowed Frontend Client Origin for CORS and Session Cookies
CLIENT_URL=http://localhost:3000
